#!/bin/sh
set -eu
ROOT="${HOME}/projects/bookplate"
P="$ROOT/app/annas_client.py"
DB="$ROOT/data/ebook.db"
PY="$ROOT/.venv/bin/python"
[ -f "$P" ] || { echo "ERROR: $P not found"; exit 1; }

"$PY" - <<'PY'
from pathlib import Path

p = Path.home() / "projects" / "bookplate" / "app" / "annas_client.py"
s = p.read_text()

anchor = '''        async def info(page, url: str, verify_seconds: int = 120):
            await page.goto(url, wait_until="domcontentloaded", timeout=60000)
'''
helper = '''        async def _stable_content(page, timeout_s: int = 20) -> str:
            """Read page HTML while tolerating Anna's automatic challenge/countdown navigations."""
            deadline = time.monotonic() + timeout_s
            last = None
            while time.monotonic() < deadline:
                try:
                    try:
                        await page.wait_for_load_state("domcontentloaded", timeout=3000)
                    except Exception:
                        pass
                    return await page.content()
                except Exception as e:
                    last = e
                    msg = str(e).lower()
                    if ("navigating" not in msg and "changing the content" not in msg
                            and "execution context" not in msg
                            and "destroyed" not in msg):
                        raise
                    await asyncio.sleep(0.25)
            raise AnnasUnavailable(
                f"Anna Chrome page never became stable: {last}")

        async def info(page, url: str, verify_seconds: int = 120):
            await page.goto(url, wait_until="domcontentloaded", timeout=60000)
'''

if "_stable_content(page" not in s:
    if anchor not in s:
        raise SystemExit("ERROR: browser helper insertion point not found")
    s = s.replace(anchor, helper, 1)

count = s.count("body = await page.content()")
if count:
    s = s.replace("body = await page.content()", "body = await _stable_content(page)")
    print(f"CONTENT_CALLS_PATCHED={count}")
else:
    print("CONTENT_CALLS_ALREADY_PATCHED")

bak = p.with_suffix(".py.bak-playwright-race")
if not bak.exists():
    bak.write_text(s)
p.write_text(s)
print("PATCH_OK")
PY

"$PY" -m py_compile "$P"
echo "PYTHON_OK"

if [ -f "$DB" ]; then
  sqlite3 "$DB" "UPDATE download_jobs SET next_attempt_at=NULL,error='',attempts=0 WHERE source='annas' AND status='queued';"
  echo "QUEUE_RESET"
fi

PIDFILE="$ROOT/data/serve.pid"
if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
  kill "$(cat "$PIDFILE")"
  sleep 2
fi
nohup "$ROOT/scripts/serve.sh" >/dev/null 2>&1 &
sleep 3
echo "BOOKPLATE_RESTARTED"
