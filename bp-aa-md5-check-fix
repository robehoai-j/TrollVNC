#!/bin/sh
set -eu
ROOT="${HOME}/projects/bookplate"
P="$ROOT/app/annas_client.py"
DB="$ROOT/data/ebook.db"
PY="$ROOT/.venv/bin/python"
[ -f "$P" ] || { echo "ERROR: $P not found"; exit 1; }
[ -x "$PY" ] || { echo "ERROR: $PY not found"; exit 1; }

"$PY" - <<'PY'
from pathlib import Path

p = Path.home() / "projects" / "bookplate" / "app" / "annas_client.py"
s = p.read_text()

old = '        page = await self._fetch_authed(f"{self._base()}/md5/{md5}")\n'
new = '        page = await self._fetch_authed(f"{self._base()}/md5/{md5}?&check=1")\n'

if new in s:
    print("MD5_CHECK_ALREADY_PRESENT")
elif old in s:
    bak = p.with_suffix(".py.bak-md5-check")
    if not bak.exists():
        bak.write_text(s)
    s = s.replace(old, new, 1)
    print("MD5_CHECK_PATCHED")
else:
    raise SystemExit("ERROR: live slow-download MD5 fetch line not found")

old2 = '''                        if hop > MAX_HOPS:
                            raise AnnasUnavailable(
                                "too many redirects from Anna's Archive")
'''
new2 = '''                        if hop > MAX_HOPS:
                            raise AnnasUnavailable(
                                f"too many redirects from Anna's Archive at {cur}")
'''
if old2 in s:
    s = s.replace(old2, new2, 1)
    print("REDIRECT_DIAG_PATCHED")
elif new2 not in s:
    print("REDIRECT_DIAG_SKIP")

p.write_text(s)
PY

"$PY" -m py_compile "$P"
echo "PYTHON_OK"

if [ -f "$DB" ]; then
  sqlite3 "$DB" "UPDATE download_jobs SET next_attempt_at=NULL,error='',attempts=0 WHERE source='annas' AND status='queued';"
  echo "QUEUE_RESET"
fi

PIDFILE="$ROOT/data/serve.pid"
if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
  kill "$(cat "$PIDFILE")"
  sleep 2
fi
nohup "$ROOT/scripts/serve.sh" >/dev/null 2>&1 &
sleep 3
echo "BOOKPLATE_RESTARTED"
