#!/bin/sh
set -eu
ROOT="${HOME}/projects/bookplate"
P="$ROOT/app/annas_client.py"
DB="$ROOT/data/ebook.db"
PY="$ROOT/.venv/bin/python"
[ -f "$P" ] || { echo "ERROR: $P not found"; exit 1; }

"$PY" - <<'PY'
from pathlib import Path

p = Path.home() / "projects" / "bookplate" / "app" / "annas_client.py"
s = p.read_text()

old = "timeout=1800000,"
new = "timeout=90000,"
if old in s:
    s = s.replace(old, new, 1)
    print("PARTNER_TIMEOUT_PATCHED=90s")
elif new in s:
    print("PARTNER_TIMEOUT_ALREADY_90s")
else:
    raise SystemExit("ERROR: Chrome partner timeout setting not found")

# Try the advertised servers in page order instead of starting from the last
# one (#16 on the user's current record, which is returning HTTP 504).
old2 = "for u in reversed(candidates):"
new2 = "for u in candidates:"
if old2 in s:
    s = s.replace(old2, new2, 1)
    print("SERVER_ORDER_PATCHED")
elif new2 in s:
    print("SERVER_ORDER_ALREADY_PATCHED")
else:
    raise SystemExit("ERROR: candidate loop not found")

bak = p.with_suffix(".py.bak-partner-timeout")
if not bak.exists():
    bak.write_text(s)
p.write_text(s)
print("PATCH_OK")
PY

"$PY" -m py_compile "$P"
echo "PYTHON_OK"

if [ -f "$DB" ]; then
  sqlite3 "$DB" "UPDATE download_jobs SET next_attempt_at=NULL,error='',attempts=0 WHERE source='annas' AND status='queued';"
  echo "QUEUE_RESET"
fi

PIDFILE="$ROOT/data/serve.pid"
if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
  kill "$(cat "$PIDFILE")"
  sleep 2
fi
nohup "$ROOT/scripts/serve.sh" >/dev/null 2>&1 &
sleep 3
echo "BOOKPLATE_RESTARTED"
