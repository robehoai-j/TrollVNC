#!/bin/sh
set -eu
ROOT="${HOME}/projects/bookplate"
P="$ROOT/app/annas_client.py"
[ -f "$P" ] || { echo "ERROR: $P not found"; exit 1; }

python3 - <<'PY'
from pathlib import Path
p = Path.home() / "projects" / "bookplate" / "app" / "annas_client.py"
s = p.read_text()
bak = p.with_suffix(".py.bak-free-v2")
if not bak.exists():
    bak.write_text(s)

changed = 0

# 1) Search: request the browser-cleared DDoS-Guard route directly.
old = '''        r = await self._fetch_authed(
            f"{self._base()}/search?q={quote_plus(q)}&page={max(1, page)}"
            + (f"&ext={quote_plus(ext)}" if ext else ""))
'''
new = '''        r = await self._fetch_authed(
            f"{self._base()}/search?q={quote_plus(q)}&page={max(1, page)}"
            + (f"&ext={quote_plus(ext)}" if ext else "")
            + "&check=1")
'''
if old in s:
    s = s.replace(old, new, 1)
    changed += 1
elif new not in s:
    raise SystemExit("ERROR: search block not found")

# 2) Free/browser-cookie mode: skip the member fast API entirely.
needle = '''        if not re.fullmatch(r"[a-f0-9]{32}", md5 or ""):
            raise AnnasConfigError(f"not an md5: {md5!r}")
'''
insert = needle + '''        if _browser_cookie():
            return await self._slow_download(md5, on_progress, expected_size)
'''
if insert not in s:
    if needle not in s:
        raise SystemExit("ERROR: download validation block not found")
    s = s.replace(needle, insert, 1)
    changed += 1

# 3) Slow download pages: use the same verified ?check=1 route.
old = '        target = f"{self._base()}/slow_download/{md5}/0/{{}}"\n'
new = '        target = f"{self._base()}/slow_download/{md5}/0/{{}}?check=1"\n'
if old in s:
    s = s.replace(old, new, 1)
    changed += 1
elif new not in s:
    raise SystemExit("ERROR: slow-download target not found")

# 4) Prevent endless same-URL guard loops; report the real bot-check instead.
old = '''        async def once() -> httpx.Response:
            hop, cur = 0, url
            base_host = httpx.URL(self._base()).host
            while True:
'''
new = '''        async def once() -> httpx.Response:
            hop, cur = 0, url
            seen = set()
            base_host = httpx.URL(self._base()).host
            while True:
                if cur in seen:
                    raise _Challenge()
                seen.add(cur)
'''
if old in s:
    s = s.replace(old, new, 1)
    changed += 1
elif new not in s:
    raise SystemExit("ERROR: redirect loop block not found")

p.write_text(s)
print(f"PATCH_OK changes={changed}")
PY

PIDFILE="$ROOT/data/serve.pid"
if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
  kill "$(cat "$PIDFILE")"
  sleep 2
fi
nohup "$ROOT/scripts/serve.sh" >/dev/null 2>&1 &
sleep 3
echo "BOOKPLATE_RESTARTED"
